<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>14</LangVersion>
        <IsPackable>false</IsPackable>
        <PublicizerRuntimeStrategies>Unsafe</PublicizerRuntimeStrategies>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    </PropertyGroup>

    <PropertyGroup>
        <OutputPath>../Assemblies</OutputPath>
        <DebugSymbols>false</DebugSymbols>
        <DebugType>none</DebugType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Krafs.Publicizer" Version="2.3.0" PrivateAssets="all" />
        <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" />
        <PackageReference Include="Lib.Harmony" Version="2.4.2" ExcludeAssets="runtime" />
        <PackageReference Include="PurePatcher.Annotations" Version="1.8.0" PrivateAssets="all" ExcludeAssets="runtime" />
    </ItemGroup>

    <ItemGroup>
        <Publicize Include="Assembly-CSharp; 0Harmony" />
        <Publicize Include="mscorlib:System.Collections.Generic.List`1._version" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="Kingfisher.sln.DotSettings" />
        <None Remove="Kingfisher.csproj.DotSettings" />
    </ItemGroup>

</Project>